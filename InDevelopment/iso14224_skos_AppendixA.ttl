@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix i14224skos: <https://iso14224.org/skos/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://iso14224.org/skos/appendixA> a owl:Ontology ;
    owl:versionIRI <https://iso14224.org/skos/appendixA/1.0> ;
    dcterms:creator <https://orcid.org/0000-0002-7336-3932> ;
    dcterms:license <https://github.com/nlp-tlp/14224ontologies_public/blob/main/LICENSE> ;
    dcterms:rights "See github"@en ;
    rdfs:comment "Terms and definitions for Appendix A of ISO 14224:2023 represented as SKOS concepts and collections."@en .


# Selected terms defined in Appendix A of ISO 14224 

#################################################################
#    Annotation properties required for Appendix A terms
#################################################################

i14224skos:mapsToTerm
    a rdf:Property ;
    skos:prefLabel "maps to term"@en ;
    rdfs:comment "maps to which term and definition in I14224 Clause 3."@en .

i14224skos:taxonomicClassificationLevel
    a rdf:Property ;
    skos:prefLabel "taxonomic classification level"@en ;    
    rdfs:comment "see Clause 8.2 Figure 3 Taxonomic classification with taxonomic levels."@en .

i14224skos:taxonomicLevelNumber
    a rdf:Property ;
    skos:prefLabel "taxonomic level number"@en ;
    rdfs:comment "see Clause 8.2 Figure 3 Taxonomic classification with taxonomic levels."@en .

i14224skos:hasEquipmentCode
    a rdf:Property ;
    skos:prefLabel "has equipment code"@en ;
    rdfs:comment "indicates the equipment code associated with the equipment unit."@en .

i14224skos:hasEquipmentCategory
    a rdf:Property ;
    skos:prefLabel "has equipment category"@en ;
    rdfs:comment "indicates the equipment category associated with the equipment unit."@en .  

#################################################################
#    Data types required for Appendix A terms
#################################################################

i14224skos:14224EqCodeLevel6
    a rdfs:Datatype ;
    rdfs:label "ISO 14224 equipment code at Level 6"@en .

i14224skos:14224EqCodeLevel7
    a rdfs:Datatype ;
    rdfs:label "ISO 14224 equipment code at Level 7"@en .


#################################################################
#    Taxonomic levels
#################################################################

i14224skos:TaxonomicLevels
    a skos:Collection ;
    skos:prefLabel "Taxonomic levels"@en ;
    skos:definition "The taxonomic levels used in the ISO 14224 classification as defined in Clause 8 Figure 3."@en ;
    skos:member 
        i14224skos:Industry,
        i14224skos:BusinessCategory,
        i14224skos:Installation,
        i14224skos:PlantOrUnit,
        i14224skos:SectionOrSystem,
        i14224skos:EquipmentUnit,
        i14224skos:EquipmentUnit,
        i14224skos:ComponentOrMaintainableItem,
        i14224skos:Part .

i14224skos:Industry
    a skos:Concept ;
    skos:prefLabel "Industry"@en ;  
    i14224skos:taxonomicLevelNumber "Level 1" ;
    skos:definition "Type of main industry."@en .

i14224skos:BusinessCategory
    a skos:Concept ;
    skos:prefLabel "Business category"@en ;
    i14224skos:taxonomicLevelNumber "Level 2" ;
    skos:definition "Type of business category."@en .

i14224skos:Installation
    a skos:Concept ;
    skos:prefLabel "Installation"@en ;  
    i14224skos:taxonomicLevelNumber "Level 3" ;
    skos:definition "Type of installation."@en .

i14224skos:PlantOrUnit
    a skos:Concept ;
    skos:prefLabel "Plant or unit"@en ;  
    i14224skos:taxonomicLevelNumber "Level 4" ;
    skos:definition "Type of plant or unit."@en .

i14224skos:SectionOrSystem
    a skos:Concept ;
    skos:prefLabel "Section or system"@en ;  
    i14224skos:taxonomicLevelNumber "Level 5" ;
    skos:definition "Type of section or system."@en .

i14224skos:EquipmentUnit
    a skos:Concept ;
    skos:prefLabel "Equipment unit"@en ;  
    i14224skos:taxonomicLevelNumber "Level 6" ;
    skos:definition "Type of equipment unit."@en .

i14224skos:SubUnit
    a skos:Concept ;
    skos:prefLabel "Sub-unit"@en ;  
    i14224skos:taxonomicLevelNumber "Level 7" ;
    skos:definition "Type of subunit."@en .

i14224skos:ComponentOrMaintainableItem
    a skos:Concept ;
    skos:prefLabel "Component or maintainable item"@en ;  
    i14224skos:taxonomicLevelNumber "Level 8" ;
    skos:definition "Type of component or maintainable item."@en .

i14224skos:Part
    a skos:Concept ;
    skos:prefLabel "Part"@en ;  
    i14224skos:taxonomicLevelNumber "Level 9" ;
    skos:definition "Type of part."@en .

i14224skos:TaxonomicLevel6Concepts
    a skos:Collection ;
    skos:prefLabel "Taxonomic level 6 concepts"@en ;
    skos:definition "Concepts with a taxonomic level number of Level 6."@en ;
    skos:member
        i14224skos:EquipmentUnit,
        i14224skos:BlowerAndFanClass,
        i14224skos:CentrifugeClass,
        i14224skos:CombustionEngineClass,
        i14224skos:CompressorClass,
        i14224skos:ElectricGeneratorClass,
        i14224skos:ElectricMotorClass,
        i14224skos:GasTurbineClass,
        i14224skos:LiquidExpanderClass,
        i14224skos:MixerClass,
        i14224skos:PumpClass,
        i14224skos:SteamTurbineClass,
        i14224skos:TurboexpanderClass,
        i14224skos:ConveyorAndElevatorClass,
        i14224skos:CraneClass,
        i14224skos:FilterAndStrainerClass,
        i14224skos:HeaterAndBoilerClass,
        i14224skos:HeatExchangerClass,
        i14224skos:LoadingArmClass,
        i14224skos:OffshorePipelineClass,
        i14224skos:PipingClass,
        i14224skos:PressureVesselClass,
        i14224skos:SiloClass,
        i14224skos:SteamEjectorClass,
        i14224skos:StorageTankClass,
        i14224skos:SwivelClass,
        i14224skos:TurretClass,
        i14224skos:WinchClass,
        i14224skos:FrequencyConverterClass,
        i14224skos:PowerCableAndTerminationClass,
        i14224skos:PowerTransformerClass,
        i14224skos:Switchgear,
        i14224skos:UninterruptiblePowerSupply,
        i14224skos:ControlLogicUnitClass,
        i14224skos:EmergencyCommunicationEquipmentClass,
        i14224skos:EscapeAndEvacuationEquipment,
        i14224skos:FireAndGasDetectorClass,
        i14224skos:FireFightingEquipmentClass,
        i14224skos:FlareIgnitionClass,
        i14224skos:InertGasEquipmentClass,
        i14224skos:InputDeviceClass,
        i14224skos:LifeboatClass,
        i14224skos:NozzleClass,
        i14224skos:TelecommunicationsClass,
        i14224skos:ValveClass .


#################################################################
#    Equipment category
#################################################################

i14224skos:EquipmentCategory
    a skos:Collection ;
    skos:prefLabel "Equipment category"@en ;
    skos:definition "Type of equipment category."@en ;
    skos:member 
    i14224skos:RotatingEquipment,
    i14224skos:MechanicalEquipment,
    i14224skos:ElectricalEquipment,
    i14224skos:SafetyAndControlEquipment.

### note subsea specific terms not included here.

i14224skos:RotatingEquipment
    a skos:Concept ;
    skos:prefLabel "Rotating equipment"@en ;
    skos:definition "Category of rotating equipment."@en .

i14224skos:MechanicalEquipment
    a skos:Concept ;
    skos:prefLabel "Mechanical equipment"@en ;
    skos:definition "Category of mechanical equipment."@en .

i14224skos:ElectricalEquipment
    a skos:Concept ;
    skos:prefLabel "Electrical equipment"@en ;
    skos:definition "Category of electrical equipment."@en .

i14224skos:SafetyAndControlEquipment
    a skos:Concept ;
    skos:prefLabel "Safety and control equipment"@en ;
    skos:definition "Category of safety and control equipment."@en .





#################################################################
#    Equipment units - Level 6
#################################################################

### Rotating equipment category

### https://iso14224.org/skos/BlowerAndFanClass
i14224skos:BlowerAndFanClass
    a skos:Concept ;
    skos:prefLabel "Blower and fan class"@en ;
    skos:broader i14224skos:EquipmentClass ;
    i14224skos:taxonomicLevelNumber "Level 6" ;
    i14224skos:taxonomicClassificationLevel i14224skos:EquipmentUnit ;
    skos:notation "BL"^^i14224skos:14224EqCodeLevel6 ;
    i14224skos:hasEquipmentCategory i14224skos:RotatingEquipment .

