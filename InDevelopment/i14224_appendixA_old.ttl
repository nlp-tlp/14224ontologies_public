@prefix i14224: <https://iso14224.org/ontology/i14224/rdl/> .
@prefix lis: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .
@prefix cmnsav: <https://www.omg.org/spec/Commons/AnnotationVocabulary#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<https://iso14224.org/ontology/i14224/ont/appendixA> rdf:type owl:Ontology ;
    owl:versionIRI <https://iso14224.org/ontology/i14224/ont/appendixA/1.0> ;
    owl:imports <https://iso14224.org/ontology/i14224/ont/clause3> ;
    dcterms:creator <https://orcid.org/0000-0002-7336-3932> ;
    dcterms:license <https://github.com/nlp-tlp/14224ontologies_public/blob/main/LICENSE> ;
    dcterms:rights "See github"@en ;
    rdfs:comment "Equipment classes and equipment types extracted from ISO 14224 Appendix A type-classification and equipment-class tables."@en .


#################################################################
#    Core classes and properties
#################################################################

i14224:EquipmentClass rdf:type owl:Class ;
    rdfs:label "Equipment class"@en ;
    rdfs:seeAlso ""@en ;
    skos:altLabel ""@en ;
    skos:definition "classification of equipment used for ISO 14224 equipment taxonomy and failure and maintenance data collection"@en ;
    skos:example ""@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixA> ;
    cmnsav:directSource "ISO 14224:2023 Appendix A"@en .

i14224:EquipmentByType rdf:type owl:Class ;
    rdfs:subClassOf i14224:EquipmentClass ;
    rdfs:label "Equipment type"@en ;
    rdfs:seeAlso ""@en ;
    skos:altLabel ""@en ;
    skos:definition "classification of an ISO 14224 equipment type within an equipment class"@en ;
    skos:example ""@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixA> ;
    cmnsav:directSource "ISO 14224:2023 Appendix A"@en .

i14224:EquipmentCode rdf:type owl:Class ;
    rdfs:label "Equipment code"@en ;
    rdfs:seeAlso ""@en ;
    skos:altLabel ""@en ;
    skos:definition "class of codes used to identify ISO 14224 equipment classes and equipment types"@en ;
    skos:example ""@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixA> ;
    cmnsav:directSource "ISO 14224:2023 Appendix A"@en .

i14224:hasEquipmentCode rdf:type owl:ObjectProperty ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (
            i14224:EquipmentClass
            i14224:EquipmentByType
        )
    ] ;
    rdfs:range i14224:EquipmentCode ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixA> ;
    rdfs:label "has equipment code"@en ;
    skos:definition "identifies the equipment code used for an equipment class or equipment type"@en ;
    cmnsav:directSource "ISO 14224:2023 Appendix A"@en .

i14224:equipment_category rdf:type owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixA> ;
    rdfs:label "equipment category"@en ;
    skos:definition "annotation property identifying the ISO 14224 Appendix A equipment category"@en ;
    cmnsav:directSource "ISO 14224:2023 Appendix A"@en .

i14224:equipment_class_level rdf:type owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixA> ;
    rdfs:label "equipment class level"@en ;
    skos:definition "annotation property identifying the ISO 14224 taxonomy level for an equipment class or equipment type entry"@en ;
    cmnsav:directSource "ISO 14224:2023 Appendix A"@en .



