Class: i14224:MaintenanceStrategyByType
    Annotations: 
        rdfs:label "Type of maintenance strategy"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "None"@en,
        cmnsav:explanatoryNote "This concept is not in ISO 14224. It is added to this ontology to create a type for maintenance strategy concepts that are included in ISO 14224 terms and definitions. These concepts are modelled as individuals (not classes) because we do not have adequate concepts and axioms to distinguish between the concepts. Also in many data sets these terms are used as labels providing a label for an instance of a work order (for example) not instances of the e.g. corrective maintenance activity"@en,
        cmnsav:usageNote ""@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        i14224:iofIRI "https://spec.industrialontologies.org/ontology/construct/MaintenanceStrategy/"^^xsd:anyURI,
        i14224:section ""^^xsd:anyURI,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "strategy for maintenance of a specific item"@en,
        skos:example "corrective maintenance, condition-based maintenance, opportunistic maintenance, planned maintenance, predictive maintenance, reactive maintenance"@en,
        skos:scopeNote ""@en

