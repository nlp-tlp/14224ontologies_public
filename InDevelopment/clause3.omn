Class: i14224:Error
    Annotations: 
        rdfs:label "Error"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "an error can be caused by a faulty item e.g. a computing error made by faulty computer equipment"@en,
        cmnsav:explanatoryNote "an error within a system can be caused by failure or one or more of its components, or by activation of a systemic fault"@en,
        cmnsav:usageNote "in ISO 14224, error is also specifically used for software and human errors"@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "Discrepancy"@en,
        skos:definition "discrepancy between a computed, observed or measured value or condition and the true, specified or theoretically correct value or condition"@en,
        skos:example ""@en,
        skos:scopeNote ""@en

Class: i14224:HumanError
    Annotations: 
        rdfs:label "Human error"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "an error can be caused by a faulty item e.g. a computing error made by faulty computer equipment"@en,
        cmnsav:explanatoryNote "the term 'human error' is often attributed in hindsight to a human decision, action or inaction considered to be an initiator or contributory cause of a negative outcome such as loss or harm"@en,
        cmnsav:usageNote "discrepancy with intention is considered essential in determining human error"@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "discrepancy between the human action taken or omitted and that intended "@en,
        skos:example "performing an incorrect action; omitting a required action "@en,
        skos:scopeNote ""@en
    SubClassOf: i14224:Error

