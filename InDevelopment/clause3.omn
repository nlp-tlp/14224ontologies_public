Individual: i14224:common_cause_failure
    Annotations: 
        rdfs:label "common cause failure"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote "Components that fail due to a shared cause normally fail in the same functional mode. The term common mode if therefore sometimes used. It is however, not considered to be a precise term for communicating the characteristics that describe a common cause failure"@en,
        i14224:definition "failures of multiple items, which would otherwise be considered independent of one another, resulting from a single cause"@en,
        i14224:definition "failures of several items resulting from the same direct cause and where these failures are not consequences of each other"@en,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "failures of multiple items, which would otherwise be considered independent of one another, resulting from a single cause"@en,
        skos:example ""@en,
        skos:scopeNote "It is generally accepted that the failures occur simultaneously or within a short time of each other"@en
    Types: i14224:FailureEventByType

Individual: i14224:common_mode_failure
    Annotations: 
        rdfs:label "common mode failure"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "The potential for common mode failures reduces the effectiveness of system redundancy"@en,
        cmnsav:usageNote "Common mode failures can have different causes"@en,
        i14224:definition "failures of different items characterized by the same failure mode"@en,
        i14224:definition "n/a"@en,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "failures of different items characterized by the same failure mode"@en,
        skos:example ""@en,
        skos:scopeNote "Common mode failures can also be common cause failures"@en
    Types: i14224:FailureEventByType

Individual: i14224:critical_failure
    Annotations: 
        rdfs:label "critical failure"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "a critical failure results in an unscheduled repair "@en,
        cmnsav:explanatoryNote "includes failures requiring immediate action towards cessation of performing the function, even though actual operation can continue for a short period of time"@en,
        cmnsav:usageNote ""@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "failure of an equipment unit that causes an immediate cessation of the ability to perform a required function"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:FailureEventByType

Individual: i14224:degraded_failure
    Annotations: 
        rdfs:label "degraded failure"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "an immediate repair can normally be delayed but, in time, such failures can develop into a critical failure if corrective actions are not taken "@en,
        cmnsav:explanatoryNote "the failure can be gradual, partial or both"@en,
        cmnsav:explanatoryNote "the function can be compromised by any combination of reduced, increased or erratic outputs "@en,
        cmnsav:usageNote ""@en,
        i14224:definition "EN13306 does not define 'degraded failure' but does define 'degraded state' as state of reduced ability to perform as required, but with acceptable reduced performance"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "failure that does not cease the fundamental function(s), but compromises one or several functions"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:FailureEventByType

Individual: i14224:failure_due_to_demand
    Annotations: 
        rdfs:label "failure due to demand"@en,
