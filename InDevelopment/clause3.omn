Class: i14224:Fault
    Annotations: 
        rdfs:label "Fault"@en,
        cmnsav:adaptedFrom "IEC 60050-192:2015 notes added"@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote "a fault is often a result of a failure of the item itself but the state can exist without a failure"@en,
        cmnsav:explanatoryNote "a fault of an item results from a failure, either of the item itself, or from a deficiency in an earlier stage of the life cycle, such as specification, design, manufacture or maintenance"@en,
        cmnsav:usageNote "see latent fault"@en,
        i14224:definition "n/a"@en,
        i14224:definition "state of an item characterized by inability to perform a required function, excluding the inability during preventive maintenance or other planned actions, or due to lack of external resources"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "inability to perform as required, due to an internal state"@en,
        skos:example ""@en,
        skos:scopeNote ""@en

