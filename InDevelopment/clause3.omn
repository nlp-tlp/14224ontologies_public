        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:FailureEventByType

Individual: i14224:corrective_maintenance
    Annotations: 
        rdfs:label "corrective maintenance"@en,
        cmnsav:adaptedFrom "IEC 60050-192:2015"@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote "corrective maintenance of software invariably involves some modification"@en,
        i14224:definition "maintenance carried out after fault recognition and intended to restore an item into a state in which it can perform a required function"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "reactive Maintenance"@en,
        skos:definition "maintenance carried out after fault detection to effect restoration"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:MaintenanceStrategyByType

Individual: i14224:planned_maintenance
    Annotations: 
        rdfs:label "planned maintenance"@en,
        cmnsav:adaptedFrom "IEC 60050-192:2015 notes added"@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote "scheduled maintenance can identify the need for some corrective maintenance"@en,
        cmnsav:usageNote ""@en,
        i14224:definition "EN13306 does not define 'planned maintenance' but does define 'scheduled maintenance' as maintenance carried out in accordance with a specified time schedule or specified number of units of use"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "planned preventative maintenance"@en,
        skos:altLabel "scheduled maintenance"@en,
        skos:definition "maintenance carried out in accordance with a specified time schedule"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:MaintenanceStrategyByType

Individual: i14224:predictive_maintenance
    Annotations: 
        rdfs:label "predictive maintenance"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote ""@en,
        i14224:definition "condition-based maintenance carried out following a forecast derived from repeated analysis or known characteristics and evaluation of the significant parameters of the degradation of the item"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "PDM"@en,
        skos:altLabel "PdM"@en,
        skos:definition "maintenance based on the prediction of the future condition of an item estimated or calculated from a defined set of historic data and known future operational parameters"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:MaintenanceStrategyByType

Individual: i14224:preventative_maintenance
    Annotations: 
        rdfs:label "preventative maintenance"@en,
        cmnsav:adaptedFrom "IEC 60050-192:2015 notes added"@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote "See also condition-based maintenance (https://iso14224.org/ontology/i14224/rdl/i14224/rdl/condition_based_maintenance) and planned (scheduled) maintenance (https://iso14224.org/ontology/i14224/rdl/i14224/rdl/planned_maintenance)"@en,
        i14224:definition "maintenance carried out after fault recognition and intended to restore an item into a state in which it can perform a required function"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "PM"@en,
        skos:definition "maintenance carried out to mitigate degradation and reduce the probability of failure"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:MaintenanceStrategyByType

Individual: i14224:condition_based_maintenance
    Annotations: 
        rdfs:label "condition based maintenance",
        cmnsav:adaptedFrom "IEC 60050-192:2015"@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "the condition assessment can be operator observation, conducted according to a schedule, or by condition monitoring of system parameters"@en,
        cmnsav:usageNote ""@en,
        i14224:definition "n/a"@en,
        i14224:definition "preventive maintenance which include assessment of physical conditions, analysis and the possible ensuing maintenance actions"@en,
