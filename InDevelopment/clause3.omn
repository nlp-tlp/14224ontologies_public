Individual: i14224:trip
    Annotations: 
        rdfs:label "trip"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote "Real trip is effectuated as a result of a monitored (or calculated) value in the control system exceeding a pre-set limit. Spurious trip is the unexpected shutdown resulting from failure(s) in control/ monitoring system or error(s) imposed on the control/monitoring system originating from the environment or people "@en,
        cmnsav:usageNote ""@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
