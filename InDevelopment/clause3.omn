        skos:scopeNote ""@en
    Types: i14224:FailureEventByType

Individual: i14224:failure_on_demand
    Annotations: 
        rdfs:label "failure on demand"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions notes added"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote "Different failure modes are used to reflect failure on demand"@en,
        cmnsav:usageNote "See also definition on failure due to demand"@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "failure likely to be observed when a demand occurs"@en,
        skos:example ""@en,
        skos:scopeNote "Failure on demand includes those failures occurred before the demand and the failures due to the demand"@en
    Types: i14224:FailureEventByType

Individual: i14224:hidden_failure
    Annotations: 
        rdfs:label "hidden failure"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote "equipment failures that occurred at an earlier point of time, but were first observed at demand fall into this category. Such failures are first revealed when the relevant functionality is tested"@en,
        cmnsav:usageNote "see latent fault"@en,
        i14224:definition "failure which is not detected during normal operation"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "failure that is not immediately evident to operations and maintenance personnel"@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:FailureEventByType

Individual: i14224:incipient_failure
    Annotations: 
        rdfs:label "incipient failure"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2016 Terms and Definitions"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote "the recording of an incipient failure requires some criteria for when a fault of this nature requires registration as opposed to a state/ condition where no corrective actions are required"@en,
        i14224:definition "n/a"@en,
        i14224:definition "n/a"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel ""@en,
        skos:definition "imperfection in the state or condition of an item so that a degraded or critical failure might (or might not) eventually be the expected result if corrective action is taken "@en,
        skos:example ""@en,
        skos:scopeNote ""@en
    Types: i14224:FailureEventByType

