Class: i14224:Failure
    Annotations: 
        rdfs:label "Failure (event)"@en,
        cmnsav:adaptedFrom "IEC 60050-192:2015 notes added"@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions"@en,
        cmnsav:explanatoryNote "a failure of an item is an event that results in a fault of the item"@en,
        cmnsav:explanatoryNote "a failure of an item is an event, as distinct from a fault of an item, which is a state"@en,
        cmnsav:usageNote ""@en,
        i14224:definition "loss of the ability of an item to perform a required function"@en,
        i14224:definition "n/a"@en,
        i14224:iofIRI "https://spec.industrialontologies.org/ontology/construct/FailureEvent/"^^xsd:anyURI,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "Failure event"@en,
        skos:definition "loss of ability to perform as required"@en,
        skos:example ""@en,
        skos:scopeNote "this concept as defined does not apply to items consisting of software only"@en

Class: i14224:FailureCause
    Annotations: 
        rdfs:label "Failure cause"@en,
        cmnsav:adaptedFrom "IEC 60050-192:2015"@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions notes added"@en,
        cmnsav:explanatoryNote "a failure cause can originate during specification, design, manufacture, installation, operation or maintenance of an item"@en,
        cmnsav:usageNote "Tables in Appendix B of ISO 14224 define failure causes for selected equipment classes"@en,
        i14224:definition "circumstances during specification, design, manufacture, installation, use or maintenance that result in failure"@en,
        i14224:definition "set of circumstances that leads to failure"@en,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "Root cause"@en,
        skos:definition "set of circumstances that leads to failure"@en,
        skos:example ""@en,
        skos:scopeNote ""@en

Class: i14224:FailureImpact
    Annotations: 
        rdfs:label "Failure impact"@en,
        cmnsav:adaptedFrom ""@en,
        cmnsav:directSource "ISO 14224:2023 Terms and Definitions notes added"@en,
        cmnsav:explanatoryNote ""@en,
        cmnsav:usageNote "classification of failure impact on taxonomy levels 4 (plant) to 8 (component/ maintainable item) are provided in ISO 14224:2023 Table 3"@en,
        cmnsav:usageNote "on the equipment level, failure impact can be classified in three classes (critical, degraded, incipient)"@en,
        i14224:definition "EN13306 does not define 'failure impact' but does define 'failure severity' as potential or actual detrimental consequences of a failure or fault"@en,
        i14224:definition "IEC60812 does not define 'failure impact' but does define 'failure effect' as consequence of a failure, within or beyond the boundary of the failure item"@en,
        i14224:iofIRI <https://spec.industrialontologies.org/ontology/construct/FailureEffect/>,
        rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/clause3>,
        rdfs:seeAlso ""@en,
        skos:altLabel "Failure consequence"@en,
        skos:altLabel "Failure effect"@en,
        skos:altLabel "Failure severity"@en,
        skos:definition "effect of a failure on an equipment's function(s) or on the plant"@en,
        skos:example ""@en,
        skos:scopeNote ""@en

