###  https://iso14224.org/ontology/i14224/rdl/Check
i14224:Check rdf:type owl:Class ;
             rdfs:subClassOf i14224:MaintenanceActivity ;
             rdfs:label "Check" ;
             rdfs:seeAlso ""@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> ""@en ;
             <http://www.w3.org/2004/02/skos/core#definition> ""@en ;
             <http://www.w3.org/2004/02/skos/core#example> "restart, resetting, no maintenance action, etc. Particularly relevant for functional failures, e.g. fire and gas detectors, subsea equipment. check includes both when a failure cause was revealed but maintenance action was considered either not necessary or not possible to carry out and where no failure cause circumstances could be found"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> ""@en ;
             i14224:iso14224:section ""^^xsd:anyURI ;
             cmnsav:adaptedFrom ""@en ;
             cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
             cmnsav:explanatoryNote "The cause of failure investigated, but no maintenance action is performed, or action is deferred. Able to regain function by simple actions, e.g. restart or resetting"@en ;
             cmnsav:usageNote "typically used in corrective maintenance"@en .


