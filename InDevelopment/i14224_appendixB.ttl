#################################################################
#    Individuals
#################################################################

## Types of Failure Mechanisms - Mechanical electrical etc. Section B2.2

###  https://iso14224.org/ontology/i14224/rdl/mechanical_failure_mechanism
i14224:mechanical_failure_mechanism a owl:NamedIndividual ,
                                     i14224:FailureMechanismByType ;
                                     skos:definition "Mechanical failure mechanism"@en .

###  https://iso14224.org/ontology/i14224/rdl/material_failure_mechanism
i14224:material_failure_mechanism a owl:NamedIndividual    ,
                                     i14224:FailureMechanismByType ;
                                     skos:definition "Material failure mechanism"@en .

###  https://iso14224.org/ontology/i14224/rdl/instrument_failure_mechanism
i14224:instrument_failure_mechanism a owl:NamedIndividual ,
                                     i14224:FailureMechanismByType ;
                                     skos:definition "Instrument failure mechanism"@en .

