### Need to check how i14224:FailureCauseByType is used
###  https://iso14224.org/ontology/i14224/rdl/hasFailureCauseByType
i14224:hasFailureCauseByType a owl:ObjectProperty ;
rdfs:label "has failure cause by type"@en ;
rdfs:domain i14224:FailureCause ;
rdfs:range i14224:FailureCauseByType .


###  https://iso14224.org/ontology/i14224/rdl/hasFailureDetectionMethod
i14224:hasFailureDetectionMethod a owl:ObjectProperty ;
rdfs:label "has failure detection method"@en ;
rdfs:range i14224:FailureDetectionMethod .


###  https://iso14224.org/ontology/i14224/rdl/hasFailureMechanism
i14224:hasFailureMechanism a owl:ObjectProperty ;
rdfs:label "has failure mechanism"@en ;
rdfs:range i14224:FailureMechanism .

###  https://iso14224.org/ontology/i14224/rdl/hasFailureModeCode
i14224:hasFailureModeCode a owl:ObjectProperty ;
rdfs:label "has failure mode code"@en ;
rdfs:domain i14224:FailureMode ;
rdfs:range i14224:FailureModeCode .


