###  https://iso14224.org/ontology/i14224/rdl/hasFailureCause
i14224:hasFailureCause rdf:type owl:ObjectProperty ;
rdfs:label "has failure cause"@en ;    
rdfs:domain i14224:FailureCause ;
rdfs:range i14224:FailureCauseByType .


###  https://iso14224.org/ontology/i14224/rdl/hasFailureCauseByType
i14224:hasFailureCauseByType rdf:type owl:ObjectProperty ;
rdfs:label "has failure cause by type"@en ;
rdfs:domain i14224:FailureCause ;
rdfs:range i14224:FailureCauseByType .


###  https://iso14224.org/ontology/i14224/rdl/hasFailureDetectionMethod
i14224:hasFailureDetectionMethod rdf:type owl:ObjectProperty ;
rdfs:label "has failure detection method"@en ;
rdfs:domain i14224:DetectionMethod ;
rdfs:range i14224:FailureDetectionMethodByType .


###  https://iso14224.org/ontology/i14224/rdl/hasFailureMechanism
i14224:hasFailureMechanism rdf:type owl:ObjectProperty ;
rdfs:label "has failure mechanism"@en .

###  https://iso14224.org/ontology/i14224/rdl/hasFailureMechanismByType
i14224:hasFailureMechanismByType rdf:type owl:ObjectProperty ;
