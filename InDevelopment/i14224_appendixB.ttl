#    Annotation properties
#################################################################

###  https://iso14224.org/ontology/i14224/rdl/hasFailureMechanismByType
i14224:hasFailureMechanismByType a owl:AnnotationProperty ;
rdfs:label "has failure mechanism type"@en .

#################################################################
#    Object Properties
#################################################################

