## General classes


###  https://iso14224.org/ontology/i14224/rdl/FailureModeCode
i14224:FailureModeCode rdf:type owl:Class ;
                       rdfs:subClassOf i14224:FailureMechanism ;
                       rdfs:label "Failure mode code" .

###  https://iso14224.org/ontology/i14224/rdl/FailureCauseByType
i14224:FailureCauseByType rdf:type owl:Class ;
                          rdfs:label "Failure cause by type" .


###  https://iso14224.org/ontology/i14224/rdl/FailureDetectionMethod
i14224:FailureDetectionMethod rdf:type owl:Class ;
                                    rdfs:label "Failure detection method" .


###  https://iso14224.org/ontology/i14224/rdl/FailureMechanismByType
i14224:FailureMechanismByType rdf:type owl:Class ;
                              rdfs:label "Failure mechanism by type" .



## Maintenance Activity classes


###  https://iso14224.org/ontology/i14224/rdl/MaintenanceActivity
i14224:MaintenanceActivity rdf:type owl:Class ;
                           rdfs:label "Maintenance activity" .

###  https://iso14224.org/ontology/i14224/rdl/Adjust
i14224:Adjust rdf:type owl:Class ;
              rdfs:subClassOf i14224:MaintenanceActivity ;
              rdfs:label "Adjust"@en ;
              skos:altLabel "align", "set and reset", "calibrate", "balance"@en ;
              cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
              cmnsav:explanatoryNote "bringing any out-of-tolerance condition into tolerance"@en ;
              cmnsav:usageNote "typically used in corrective and preventative maintenance"@en .

###  https://iso14224.org/ontology/i14224/rdl/Check
i14224:Check rdf:type owl:Class ;
             rdfs:subClassOf i14224:MaintenanceActivity ;
             rdfs:label "Check" ;
             skos:altLabel "restart","reset"@en ;
             cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
             cmnsav:explanatoryNote "The cause of failure investigated, but no maintenance action is performed, or action is deferred. Able to regain function by simple actions, e.g. restart or resetting etc. Particularly relevant for functional failures, e.g. fire and gas detectors, subsea equipment. check includes both when a failure cause was revealed but maintenance action was considered either not necessary or not possible to carry out and where no failure cause circumstances could be found"@en ;
             cmnsav:usageNote "typically used in corrective maintenance"@en .

###  https://iso14224.org/ontology/i14224/rdl/CombinationMaintenanceActivity
i14224:CombinationMaintenanceActivity rdf:type owl:Class ;
                                      rdfs:subClassOf i14224:MaintenanceActivity ;
                                      rdfs:label "Combination maintenance activity"@en ;
                                      cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
                                      cmnsav:explanatoryNote "Several maintenance activities are included"@en ;
                                      cmnsav:usageNote "Typically used in corrective and preventative maintenance. If one activity dominates, this may alternatively be recorded"@en .


###  https://iso14224.org/ontology/i14224/rdl/Inspection
i14224:Inspection rdf:type owl:Class ;
                  rdfs:subClassOf i14224:MaintenanceActivity ;
                  rdfs:label "Inspection"@en ;
                  rdfs:seeAlso ""@en ;
                  skos:altLabel "Inspect"@en ;
                  cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
                  cmnsav:explanatoryNote "periodic inspection/check: a careful scrutiny of an item carried out with or without dismantling, normally by use of senses"@en ;
                  cmnsav:usageNote "Typically used in preventative maintenance. All types of general check. Includes minor servicing as part of the inspection task"@en .

###  https://iso14224.org/ontology/i14224/rdl/Modify
i14224:Modify rdf:type owl:Class ;
              rdfs:subClassOf i14224:MaintenanceActivity ;
              rdfs:label "Modify"@en ;
              cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
              cmnsav:explanatoryNote "Replace, renew or change the item, or a part of it, with an item/part of a different type, make, material or design"@en ;
              cmnsav:usageNote "Typically used in preventative maintenance. Such as install a filter with a smaller mesh diameter, replace a lubrication oil pump with another type, reconfiguration etc."@en .


###  https://iso14224.org/ontology/i14224/rdl/OtherMaintenanceActivity
i14224:OtherMaintenanceActivity rdf:type owl:Class ;
                                rdfs:subClassOf i14224:MaintenanceActivity ;
                                rdfs:label "Other maintenance activity" ;
                                cmnsav:directSource "ISO 14224:2023 Appendix B"@en .

###  https://iso14224.org/ontology/i14224/rdl/Overhaul
i14224:Overhaul rdf:type owl:Class ;
                rdfs:subClassOf i14224:MaintenanceActivity ;
                rdfs:label "Overhaul"@en ;
                skos:altLabel "Major repair"@en ;
                cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
                cmnsav:explanatoryNote "Major overhaul"@en ;
                cmnsav:usageNote "Typically used in preventative and corrective maintenance. Comprehensive inspection/ overhaul with extensive disassembly and replacement of items as specified or required"@en .

###  https://iso14224.org/ontology/i14224/rdl/Refit
i14224:Refit rdf:type owl:Class ;
             rdfs:subClassOf i14224:MaintenanceActivity ;
             rdfs:label "Refit"@en ;
             rdfs:seeAlso ""@en ;
             skos:altLabel "polish", "clean", "grind", "paint", "coat", "lube", "oil change"@en ;
             cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
             cmnsav:explanatoryNote "minor repair/ servicing activity to bring back an item to an acceptable appearance, internal and external"@en ;
             cmnsav:usageNote "Typically used in corrective and preventative maintenance. "@en .


###  https://iso14224.org/ontology/i14224/rdl/Repair
i14224:Repair rdf:type owl:Class ;
              rdfs:subClassOf i14224:MaintenanceActivity ;
              rdfs:label "Repair"@en ;
              skos:altLabel "repack", "weld", "plus", "reconnect", "remake"@en ;
              cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
              cmnsav:explanatoryNote "Manual maintenance action performed to restore an item to its original appearance or state"@en ;
              cmnsav:usageNote "Typically used in corrective maintenance."@en .


###  https://iso14224.org/ontology/i14224/rdl/Replace
i14224:Replace rdf:type owl:Class ;
               rdfs:subClassOf i14224:MaintenanceActivity ;
               rdfs:label "Replace"@en ;
               cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
               cmnsav:explanatoryNote "Replacement of the item by a new or refurbished item of the same type and make"@en ;
               cmnsav:usageNote "Typically used in preventative and corrective maintenance. E.g. replacement of a worn-out bearing"@en .


###  https://iso14224.org/ontology/i14224/rdl/Service
i14224:Service rdf:type owl:Class ;
               rdfs:subClassOf i14224:MaintenanceActivity ;
               rdfs:label "Service"@en ;
               skos:altLabel "clean", "replenishment","adjust", "adjustment", "calibration"@en ;
               cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
               cmnsav:explanatoryNote "Periodic service tasks. Normally no dismantling of the item"@en ;
               cmnsav:usageNote "Typically used in preventative maintenance. "@en .

###  https://iso14224.org/ontology/i14224/rdl/Test
i14224:Test rdf:type owl:Class ;
            rdfs:subClassOf i14224:MaintenanceActivity ;
            rdfs:label "Test"@en ;
            cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
            cmnsav:explanatoryNote "Periodic test of function or performance"@en ;
            cmnsav:usageNote "Typically used in preventative maintenance. e.g. function test of gas detector, accuracy test of flow meter"@en .


## Failure Mechanism

