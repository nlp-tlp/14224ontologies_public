###  https://iso14224.org/ontology/i14224/rdl/Adjust
i14224:Adjust rdf:type owl:Class ;
              rdfs:subClassOf i14224:MaintenanceActivity ;
              rdfs:label "Adjust"@en ;
              rdfs:seeAlso ""@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> ""@en ;
              <http://www.w3.org/2004/02/skos/core#definition> ""@en ;
              <http://www.w3.org/2004/02/skos/core#example> "align, set and reset, calibrate, balance"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> ""@en ;
              i14224:iso14224:section ""^^xsd:anyURI ;
              cmnsav:adaptedFrom ""@en ;
              cmnsav:directSource "ISO 14224:2023 Appendix B"@en ;
              cmnsav:explanatoryNote "bringing any out-of-tolerance condition into tolerance"@en ;
              cmnsav:usageNote "typically used in corrective and preventative maintenance"@en .


