@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix i14224skos: <https://iso14224.org/skos/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://iso14224.org/skos/appendixA> a owl:Ontology ;
    owl:versionIRI <https://iso14224.org/skos/appendixA/1.0> ;
    dcterms:creator <https://orcid.org/0000-0002-7336-3932> ;
    dcterms:license <https://github.com/nlp-tlp/14224ontologies_public/blob/main/LICENSE> ;
    dcterms:rights "See github"@en ;
    rdfs:comment "Terms and definitions for Appendix A of ISO 14224:2023 represented as SKOS concepts and collections."@en .


# Selected terms defined in Appendix A of ISO 14224 





# Predicates required for Appendix A terms

i14224skos:taxonomicClassificationLevel
    a rdf:Property ;
    skos:prefLabel "taxonomic classification level"@en ;    
    rdfs:comment "see Clause 8.2 Figure 3 Taxonomic classification with taxonomic levels."@en .

i14224skos:taxonomicLevelNumber
    a rdf:Property ;
    skos:prefLabel "taxonomic level number"@en ;
    rdfs:comment "see Clause 8.2 Figure 3 Taxonomic classification with taxonomic levels."@en .



#################################################################
#    Taxonomic levels
#################################################################

i14224skos:TaxonomicLevels
    a skos:Collection ;
    skos:prefLabel "Taxonomic levels"@en ;
    skos:definition "The taxonomic levels used in the ISO 14224 classification as defined in Clause 8 Figure 3."@en ;
    skos:member 
        i14224skos:Industry,
        i14224skos:BusinessCategory,
        i14224skos:Installation,
        i14224skos:PlantOrUnit,
        i14224skos:SectionOrSystem,
        i14224skos:EquipmentUnit,
        i14224skos:SubUnit,
        i14224skos:ComponentOrMaintainableItem,
        i14224skos:Part .

i14224skos:Industry
    a skos:Concept ;
    skos:prefLabel "Industry"@en ;  
    i14224skos:taxonomicLevelNumber "Level 1" ;
    skos:definition "Type of main industry."@en .

i14224skos:BusinessCategory
    a skos:Concept ;
    skos:prefLabel "Business category"@en ;
    i14224skos:taxonomicLevelNumber "Level 2" ;
    skos:definition "Type of business category."@en .

i14224skos:Installation
    a skos:Concept ;
    skos:prefLabel "Installation"@en ;  
    i14224skos:taxonomicLevelNumber "Level 3" ;
    skos:definition "Type of installation."@en .

i14224skos:PlantOrUnit
    a skos:Concept ;
    skos:prefLabel "Plant or unit"@en ;  
    i14224skos:taxonomicLevelNumber "Level 4" ;
    skos:definition "Type of plant or unit."@en .

i14224skos:SectionOrSystem
    a skos:Concept ;
    skos:prefLabel "Section or system"@en ;  
    i14224skos:taxonomicLevelNumber "Level 5" ;
    skos:definition "Type of section or system."@en .

i14224skos:EquipmentUnit
    a skos:Concept ;
    skos:prefLabel "Equipment unit"@en ;  
    i14224skos:taxonomicLevelNumber "Level 6" ;
    skos:definition "Type of equipment unit."@en .

i14224skos:SubUnit
    a skos:Concept ;
    skos:prefLabel "Sub-unit"@en ;  
    i14224skos:taxonomicLevelNumber "Level 7" ;
    skos:definition "Type of subunit."@en .

i14224skos:ComponentOrMaintainableItem
    a skos:Concept ;
    skos:prefLabel "Component or maintainable item"@en ;  
    i14224skos:taxonomicLevelNumber "Level 8" ;
    skos:definition "Type of component or maintainable item."@en .

i14224skos:Part
    a skos:Concept ;
    skos:prefLabel "Part"@en ;  
    i14224skos:taxonomicLevelNumber "Level 9" ;
    skos:definition "Type of part."@en .


#################################################################
#    Equipment category
#################################################################

i14224skos:EquipmentCategory
    a skos:Collection ;
    skos:prefLabel "Equipment category"@en ;
    skos:definition "Type of equipment category."@en ;
    skos:member 
    i14224skos:Rotating,
    i14224skos:Mechanical,
    i14224skos:Electrical,
    i14224skos:SafetyAndControl,
    i14224skos:Subsea,
    i14224skos:WellCompletion,
    i14224skos:Drilling,
    i14224skos:WellIntervention,
    i14224skos:Marine,
    i14224skos:Utilities,
    i14224skos:Auxiliaries .


i14224skos:RotatingEquipment
    a skos:Concept ;
    skos:prefLabel "Rotating equipment"@en ;
    skos:definition "Category of rotating equipment."@en .

i14224skos:MechanicalEquipment
    a skos:Concept ;
    skos:prefLabel "Mechanical equipment"@en ;
    skos:definition "Category of mechanical equipment."@en .

i14224skos:ElectricalEquipment
    a skos:Concept ;
    skos:prefLabel "Electrical equipment"@en ;
    skos:definition "Category of electrical equipment."@en .

i14224skos:SafetyAndControlEquipment
    a skos:Concept ;
    skos:prefLabel "Safety and control equipment"@en ;
    skos:definition "Category of safety and control equipment."@en .

i14224skos:SubseaEquipment
    a skos:Concept ;
    skos:prefLabel "Subsea equipment"@en ;
    skos:definition "Category of subsea equipment."@en .

i14224skos:WellCompletionEquipment
    a skos:Concept ;
    skos:prefLabel "Well completion equipment"@en ;
    skos:definition "Category of well completion equipment."@en .

i14224skos:DrillingEquipment
    a skos:Concept ;
    skos:prefLabel "Drilling equipment"@en ;
    skos:definition "Category of drilling equipment."@en .

i14224skos:WellInterventionEquipment
    a skos:Concept ;
    skos:prefLabel "Well intervention equipment"@en ;
    skos:definition "Category of well intervention equipment."@en .

i14224skos:MarineEquipment
    a skos:Concept ;
    skos:prefLabel "Marine equipment"@en ;
    skos:definition "Category of marine equipment."@en .

i14224skos:UtilitiesEquipment
    a skos:Concept ;
    skos:prefLabel "Utilities equipment"@en ;
    skos:definition "Category of utilities equipment."@en .

i14224skos:AuxiliariesEquipment
    a skos:Concept ;
    skos:prefLabel "Auxiliaries equipment"@en ;
    skos:definition "Category of auxiliaries equipment."@en .



