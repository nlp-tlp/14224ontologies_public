@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix i14224skos: <https://iso14224.org/skos/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Global concepts

i14224skos:StandardISO14224 a skos:ConceptScheme;
    skos:altLabel ""@en ;
    skos:definition "ISO 14224:2023 standard for the collection and exchange of reliability and maintenance data for equipment"@en ;
    skos:prefLabel "ISO 14224 standard"@en ;
    skos:scopeNote ""@en .

# New terms added to create SKOS Collections

i14224skos:TypeTest a skos:Collection ;
    skos:altLabel ""@en ;
    skos:definition "label describing the nature of a test"@en ;
    skos:example "on demand test, periodic test"@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "type of test"@en ;
    skos:scopeNote ""@en .


i14224skos:TypeMaterialState a skos:Collection ;
    skos:altLabel ""@en ;
    skos:definition "process in which a material entity (item) that participates in the process has a condition that remains unchanged"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "type of material state"@en ;
    skos:scopeNote ""@en .


i14224skos:TypeData a skos:Collection ;
    skos:altLabel ""@en ;
    skos:definition "label why the data is collected"@en ;
    skos:example "reliability data, maintenance data"@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "type of data"@en ;
    skos:scopeNote ""@en .


i14224skos:TypeMaintenanceStrategy a skos:Collection ;
    skos:altLabel ""@en ;
    skos:definition "strategy for maintenance of a specific item"@en ;
    skos:example "corrective maintenance, condition-based maintenance, opportunistic maintenance, planned maintenance, predictive maintenance, reactive maintenance"@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "type of maintenance strategy"@en ;
    skos:scopeNote ""@en .


i14224skos:TypeFailureEvent a skos:Collection ;
    skos:altLabel ""@en ;
    skos:definition "label describing the way engineers commonly describe failure events"@en ;
    skos:example "critical, hidden, common cause"@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "type of failure event"@en ;
    skos:scopeNote ""@en .


i14224skos:ReliabilityMeasureTerms a skos:Collection ;
    skos:altLabel ""@en ;
    skos:definition "terms that define the reliability-related performance of an item "@en ;
    skos:example "reliability, maintainability, availability"@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "reliability measures"@en ;
    skos:member
        i14224skos:ActiveMaintenanceTime,
        i14224skos:ActiveRepairTime,
        i14224skos:Availability,
        i14224skos:FailureFrequency ,
        i14224skos:FailureRate ,
        i14224skos:Integrity ,
        i14224skos:LogisticDelay ,
        i14224skos:MaintenanceSupportability ,
        i14224skos:MeanCyclesToFailure ,
        i14224skos:MeanNumberOfCycles ,
        i14224skos:MeanActiveRepairTime ,
        i14224skos:MeanElapsedTime ,
        i14224skos:MeanOverallRepairingTime ,
        i14224skos:MeanTimeToFailure ,
        i14224skos:MeanTimeToRepair ,
        i14224skos:MeanTimeToRestoration ,
        i14224skos:MobilizationTime ,
        i14224skos:OperatingTime ,
        i14224skos:Reliability ,
        i14224skos:SurveillanceTime ,
        i14224skos:Uptime .


# Terms defined in Clause 3 of ISO 14224 (scope notes not yet added)

i14224skos:ActiveMaintenanceTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "duration of a maintenance action, excluding logistic delay"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "active maintenance time"@en ;
    skos:scopeNote ""@en .

i14224skos:ActiveRepairTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "effective time to achieve repair of an item"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "active repair time"@en ;
    skos:scopeNote ""@en .

i14224skos:Availability a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "ability to be in a state to perform as required"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "availability"@en ;
    skos:scopeNote ""@en .

i14224skos:Boundary a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "interface between an item and its surroundings"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "boundary"@en ;
    skos:scopeNote ""@en .    

i14224skos:CommonCauseFailures a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failures of multiple items, which would otherwise be considered independent of one another, resulting from a single cause"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "common cause failures"@en ;
    skos:scopeNote "It is generally accepted that the failures occur simultaneously or within a short time of each other"@en .

i14224skos:CommonModeFailures a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failures of different items characterized by the same failure mode"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "common mode failures"@en ;
    skos:scopeNote "Common mode failures can also be common cause failures"@en .

i14224skos:ConditionBasedMaintenance a skos:Concept ;
    skos:altLabel "cbm"@en ;
    skos:broader i14224skos:TypeMaintenanceStrategy ;
    skos:definition "preventative maintenance based on assessment of physical condition"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "condition based maintenance" ;
    skos:scopeNote ""@en .

i14224skos:CorrectiveMaintenance a skos:Concept ;
    skos:altLabel "reactive Maintenance"@en ;
    skos:broader i14224skos:TypeMaintenanceStrategy ;
    skos:definition "maintenance carried out after fault detection to effect restoration"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "corrective maintenance"@en ;
    skos:scopeNote ""@en .

i14224skos:CriticalFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure of an equipment unit that causes an immediate cessation of the ability to perform a required function"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "critical failure"@en ;
    skos:scopeNote ""@en .

i14224skos:Cycle a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "operation and subsequent release/reset"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "cycle"@en ;
    skos:scopeNote ""@en .    

i14224skos:DegradedFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure that does not cease the fundamental function(s), but compromises one or several functions"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "degraded failure"@en ;
    skos:scopeNote ""@en .

i14224skos:Demand a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeTest ;
    skos:definition "activation of the function (includes functional, operational and test activations)"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "demand"@en ;
    skos:scopeNote ""@en .

i14224skos:DesignLife a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "planned usage time for the total system"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "designLife"@en ;
    skos:scopeNote ""@en .

i14224skos:DetectionMethod a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "method or activity by which a failure is discovered"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "detection method"@en ;
    skos:scopeNote ""@en .
    
i14224skos:DownState a skos:Concept ;
    skos:altLabel "internal disabled state"@en,
        "internally disabled state"@en,
        "unavailable state"@en ;
    skos:broader i14224skos:TypeMaterialState ;
    skos:definition "state of being unable to perform as required, due to internal fault, or preventative maintenance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "down state"@en ;
    skos:scopeNote ""@en .


i14224skos:Downstream a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "business category most commonly used in the petroleum industry to describe post-production processes"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "downstream"@en ;
    skos:scopeNote ""@en .

i14224skos:Downtime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "time interval during which an item is in a down state "@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "downtime"@en ;
    skos:scopeNote ""@en .

i14224skos:EquipmentClass a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "class of similar type of equipment units"@en ;
    skos:example "e.g. pumps "@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "equipment class"@en ;
    skos:scopeNote ""@en .

i14224skos:EquipmentData a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeData ;
    skos:definition "technical, operational and environmental parameters characterizing the design and use of an equipment unit"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "equipment data"@en ;
    skos:scopeNote ""@en .

i14224skos:EquipmentType a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "particular feature of the design which is significantly different from the other design(s) within the same equipment class"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "equipment type"@en ;
    skos:scopeNote ""@en .

i14224skos:EquipmentUnit a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "specific equipment within an equipment class as defined by its boundary"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "equipment unit"@en ;
    skos:scopeNote ""@en .

i14224skos:Error a skos:Concept ;
    skos:altLabel "discrepancy"@en ;
    skos:definition "discrepancy between a computed, observed or measured value or condition and the true, specified or theoretically correct value or condition"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "error"@en ;
    skos:scopeNote ""@en .

i14224skos:Failure a skos:Concept ;
    skos:altLabel "failure event"@en ;
    skos:definition "loss of ability to perform as required"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure (event)"@en ;
    skos:scopeNote "this concept as defined does not apply to items consisting of software only"@en .


i14224skos:FailureCause a skos:Concept ;
    skos:altLabel "root cause"@en ;
    skos:definition "set of circumstances that leads to failure"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure cause"@en ;
    skos:scopeNote ""@en .

i14224skos:FailureData a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeData ;
    skos:definition "data characterizing the occurrence of a failure event"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure data"@en ;
    skos:scopeNote ""@en .

i14224skos:FailureDueToDemand a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure occurring on demand"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure due to demand"@en ;
    skos:scopeNote ""@en . 

i14224skos:FailureFrequency a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "unconditional failure intensity; conditional probability per unit time that the item fails between t and t + dt, provided that it was working at time 0"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure frequency"@en ;
    skos:scopeNote ""@en .       

i14224skos:FailureImpact a skos:Concept ;
    skos:altLabel "failure consequence"@en,
        "failure effect"@en,
        "failure severity"@en ;
    skos:definition "effect of a failure on an equipment's function(s) or on the plant"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure impact"@en ;
    skos:scopeNote ""@en .

i14224skos:FailureMechanism a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "process that leads to failure"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure mechanism"@en ;
    skos:scopeNote ""@en .

i14224skos:FailureMode a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "manner in which failure occurs"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure mode"@en ;
    skos:scopeNote ""@en .    

i14224skos:FailureOnDemand a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure likely to be observed when a demand occurs"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure on demand"@en ;
    skos:scopeNote "Failure on demand includes those failures occurred before the demand and the failures due to the demand"@en .

i14224skos:FailureRate a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "conditional probability per unit time that the item fails between t and t + dt, provided that it has been working over 0, t"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure rate"@en ;
    skos:scopeNote ""@en .

i14224skos:Fault a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "inability to perform as required, due to an internal state"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "fault"@en ;
    skos:scopeNote ""@en .

i14224skos:GenericReliabilityData a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeData ;
    skos:definition "reliability data covering families of similar equipment"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "failure frequency"@en ;
    skos:scopeNote ""@en .

i14224skos:HiddenFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure that is not immediately evident to operations and maintenance personnel"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "hidden failure"@en ;
    skos:scopeNote ""@en .

i14224skos:HumanError a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:Error ;
    skos:definition "discrepancy between the human action taken or omitted and that intended "@en ;
    skos:example "performing an incorrect action; omitting a required action "@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "human error"@en ;
    skos:scopeNote ""@en .

i14224skos:HumanFatigue a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "loss of physiological and psychological function as a result of extended wakefulness, heavy work, excessive stimulation, illness or stress"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "human fatigue"@en ;
    skos:scopeNote ""@en .

i14224skos:IdleState a skos:Concept ;
    skos:altLabel "standby state"@en ;
    skos:broader i14224skos:TypeMaterialState ;
    skos:definition "non-operating up state during non-required time"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "idle state"@en ;
    skos:scopeNote ""@en .    

i14224skos:IdleTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "time interval for which an item is in an idle state"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "idle time"@en ;
    skos:scopeNote ""@en .

i14224skos:IncipientFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "imperfection in the state or condition of an item so that a degraded or critical failure might (or might not) eventually be the expected result if corrective action is taken "@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "incipient failure"@en ;
    skos:scopeNote ""@en .

i14224skos:IndentureLevel a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "level of subdivision of an item from the point of view of maintenance action"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "indenture"@en ;
    skos:scopeNote ""@en .

i14224skos:Integrity a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "ability of a barrier to function as required when needed"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "integrity"@en ;
    skos:scopeNote ""@en .

i14224skos:Item a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "subject being considered"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "item"@en ;
    skos:scopeNote ""@en .

i14224skos:LatentFault a skos:Concept ;
    skos:altLabel "undetected fault"@en ;
    skos:broader i14224skos:Fault ;
    skos:definition "<of an item>fault that has not become apparent"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "latent fault"@en ;
    skos:scopeNote ""@en .

i14224skos:LifeCycle a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "series of identifiable stages through which an item goes, from its conception to disposal"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "life cycle"@en ;
    skos:scopeNote ""@en .    

i14224skos:LogisticDelay a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "delay, excluding administrative delay, incurred for the provision of resources needed for a maintenance action to proceed or continue"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "logistic delay"@en ;
    skos:scopeNote ""@en .

i14224skos:Maintainability a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "ability to be retained in, or restored to a state to perform as required, under given conditions of use and maintenance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintainability"@en ;
    skos:scopeNote ""@en .

i14224skos:MaintainableItem a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "item that constitutes a part or an assembly of parts that is normally the lowest level in the equipment hierarchy during maintenance "@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintainable item"@en ;
    skos:scopeNote ""@en .


i14224skos:Maintenance a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "combination of all technical and management actions intended to retain an item in, or restore it to, a state in which it can perform as required "@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance"@en ;
    skos:scopeNote ""@en .


i14224skos:MaintenanceConcept a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "definition of the maintenance objectives, line of maintenance, indenture levels, maintenance levels, maintenance support, and their interrelationships"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance concept"@en ;
    skos:scopeNote ""@en .

i14224skos:MaintenanceData a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeData ;
    skos:definition "data characterizing the maintenance action planned or done"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance data"@en ;
    skos:scopeNote ""@en .    


i14224skos:MaintenanceImpact a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "effect of the maintenance on the plant or equipment's function(s)"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance impact"@en ;
    skos:scopeNote ""@en .


i14224skos:MaintenanceManHours a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "accumulated duration of the individual maintenance times used by all maintenance personnel for a given type of maintenance action or over a given time interval"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance man-hours"@en ;
    skos:scopeNote ""@en .


i14224skos:MaintenancePlan a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "structured and documented set of tasks that include the activities, procedures, resources and the time scale required to carry out maintenance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance plan"@en ;
    skos:scopeNote ""@en .


i14224skos:MaintenanceRecord a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "part of maintenance documentation that contains all failures, faults and maintenance action relating to an item"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance record"@en ;
    skos:scopeNote ""@en .

i14224skos:MaintenanceSupportability a skos:Concept ;
    skos:altLabel "supportability"@en ;
    skos:definition "<of an item> ability to be supported to sustain the required availability with a defined operational profile and given logistic and maintenance resources"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "maintenance supportability"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanCyclesToFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "expected number of cycles before the item fails"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean cycles to failure"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanNumberOfCycles a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "expected number of cycles per unit time"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean number of cycles"@en ;
    skos:scopeNote ""@en .    

i14224skos:MeanActiveRepairTime a skos:Concept ;
    skos:altLabel "mART"@en ;
    skos:definition "expected active repair time"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean cycles to failure"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanElapsedTimeBetweenFailures a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "expected elapsed time between failures"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean elapsed time between failures"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanOverallRepairingTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "expected time to achieve the following actions: the time spent before starting the repair; and, the effective time to repair; and, the time before the item is made available to be put back into operation"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean overall repairing time"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanTimeToFailure a skos:Concept ;
    skos:altLabel "mTTF"@en ;
    skos:definition "expected time before the item fails"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean time to failure"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanTimeToRepair a skos:Concept ;
    skos:altLabel "mTTR"@en ;
    skos:definition "expected time to achieve the repair of a failed item"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean time to repair"@en ;
    skos:scopeNote ""@en .

i14224skos:MeanTimeToRestoration a skos:Concept ;
    skos:altLabel "mean_elapsed_time_between_failures"@en ;
    skos:definition "expected time to the following actions: the time to detect the failure; and, the time spent before starting the repair; and, the effective time to repair; and, the time before the component is made available to be put back into operation"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mean time to restoration"@en ;
    skos:scopeNote ""@en .

i14224skos:Midstream a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "business category involving the processing, storage and transportation sectors of the petroleum industry"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "midstream"@en ;
    skos:scopeNote "Redundancy in IEC 61508 is called fault tolerance"@en .

i14224skos:MobilizationTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "time to get all necessary resources available to execute maintenance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "mobilization time"@en ;
    skos:scopeNote ""@en .

i14224skos:Modification a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "combination of all technical and administrative actions intended to change an item"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "modification"@en ;
    skos:scopeNote "Modification is not normally a part of maintenance, but is frequently performed by maintenance personnel"@en .    

i14224skos:NonCriticalFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure of an equipment unit that does not cause an immediate cessation of an ability to perform its required function"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "non-critical failure"@en ;
    skos:scopeNote ""@en .

i14224skos:OperatingState a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeMaterialState ;
    skos:definition "state of performing as required"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "operating state"@en ;
    skos:scopeNote ""@en .

i14224skos:OperatingTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "time interval during which an item is in an operating state"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "operating time"@en ;
    skos:scopeNote ""@en .

i14224skos:OpportunityMaintenance a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeMaintenanceStrategy ;
    skos:definition "maintenance of an item that is deferred or advanced in time and is performed when an unplanned opportunity becomes available"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "opportunity maintenance" ;
    skos:scopeNote ""@en .

i14224skos:PerformanceObjective a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "indicative level for the desired performance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "performance objective"@en ;
    skos:scopeNote ""@en .

i14224skos:PerformanceRequirement a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "required minimum level for the performance of a system"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "performance requirement"@en ;
    skos:scopeNote ""@en .

i14224skos:PeriodicTest a skos:Concept ;
    skos:altLabel "proof test"@en ;
    skos:broader i14224skos:TypeTest ;
    skos:definition "planned operation performed at constant intervals in order to detect the potential hidden failures which can have occurred in the meantime "@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "periodic test"@en ;
    skos:scopeNote ""@en .

i14224skos:Petrochemical a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "business category producing chemicals derived from petroleum and used as a feedstock for the manufacture of a variety of plastics and other related products"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "petrochemical"@en ;
    skos:scopeNote ""@en .    

i14224skos:PlannedMaintenance a skos:Concept ;
    skos:altLabel "planned preventative maintenance"@en,
        "scheduled maintenance"@en ;
    skos:broader i14224skos:TypeMaintenanceStrategy ;
    skos:definition "maintenance carried out in accordance with a specified time schedule"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "planned maintenance"@en ;
    skos:scopeNote ""@en .

i14224skos:PredictiveMaintenance a skos:Concept ;
    skos:altLabel "pDM"@en,
        "pdM"@en ;
    skos:broader i14224skos:TypeMaintenanceStrategy ;
    skos:definition "maintenance based on the prediction of the future condition of an item estimated or calculated from a defined set of historic data and known future operational parameters"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "predictive maintenance"@en ;
    skos:scopeNote ""@en .

i14224skos:PreventativeMaintenance a skos:Concept ;
    skos:altLabel "pM"@en ;
    skos:broader i14224skos:TypeMaintenanceStrategy ;
    skos:definition "maintenance carried out to mitigate degradation and reduce the probability of failure"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "preventative maintenance"@en ;
    skos:scopeNote ""@en .

i14224skos:RandomFailure a skos:Concept ;
    skos:altLabel "pDM"@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure occurring in a random way"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "random failure"@en ;
    skos:scopeNote ""@en .

i14224skos:Redundancy a skos:Concept ;
    skos:altLabel "pDM"@en ;
    skos:definition "existence of more than one means for performing a required function of an item"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "redundancy"@en ;
    skos:scopeNote "Redundancy in IEC 61508 is called fault tolerance"@en .

i14224skos:Reliability a skos:Concept ;
    skos:altLabel "pDM"@en ;
    skos:definition "ability of an item to perform a required function under given conditions for a given time interval"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "reliability"@en ;
    skos:scopeNote "Redundancy in IEC 61508 is called fault tolerance"@en .

i14224skos:ReliabilityData a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeData ;
    skos:definition "data for reliability, maintainability and maintenance support performance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "reliability data"@en ;
    skos:scopeNote ""@en .

i14224skos:RequiredFunction a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "function or combination of functions of an item that is considered necessary to provide a given service"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "required function"@en ;
    skos:scopeNote ""@en .    

i14224skos:SafetyCriticalEquipment a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "equipment and items of permanent, temporary and portable equipment playing an important role in safety systems/ functions"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "safety critical equipment"@en ;
    skos:scopeNote ""@en .

i14224skos:SafetyCriticalFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "critical dangerous failures that are undetected"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "safety critical failure"@en ;
    skos:scopeNote ""@en .

i14224skos:SafetySystem a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "system which is used to implement one or more safety functions"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "safety system"@en ;
    skos:scopeNote ""@en .

i14224skos:SoftwareError a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:Error ;
    skos:definition "erroneous result produced by the use of software product"@en ;
    skos:example "Bad code in a computer program resulting in an error"@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "software error"@en ;
    skos:scopeNote ""@en .

i14224skos:SubUnit a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "assembly of items that provides a specific function that is required for the equipment unit within the main boundary to achieve its intended performance"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "subunit"@en ;
    skos:scopeNote ""@en .    

i14224skos:SurveillancePeriod a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "interval of time (calendar time) between the start date and the end date of RM data collection"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "surveillance period"@en ;
    skos:scopeNote ""@en .

i14224skos:SystematicFailure a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "failure that consistently occurs under particular conditions of handling, storage or use"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "systematic failure"@en ;
    skos:scopeNote ""@en .

i14224skos:TagNumber a skos:Concept ;
    skos:altLabel "functional location"@en ;
    skos:definition "unique code that identifies the equipment function and its physical location"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "tag number"@en ;
    skos:scopeNote ""@en .    

i14224skos:Taxonomy a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "systematic classification of items into generic groups based on factors possibly common to several of the items"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "taxonomy"@en ;
    skos:scopeNote ""@en .

i14224skos:Trip a skos:Concept ;
    skos:altLabel ""@en ;
    skos:broader i14224skos:TypeFailureEvent ;
    skos:definition "shutdown of machinery from normal operating condition to full stop"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "trip"@en ;
    skos:scopeNote ""@en .

i14224skos:Turnaround a skos:Concept ;
    skos:altLabel "revision shutdown"@en,
        "shutdown"@en ;
    skos:definition "planned event wherein an entire process unit is taken off stream for revamp or renewal"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "turnaround"@en ;
    skos:scopeNote ""@en .       

i14224skos:UpState a skos:Concept ;
    skos:altLabel "available state"@en ;
    skos:broader i14224skos:TypeMaterialState ;
    skos:definition "state of being able to perform as required"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "up state"@en ;
    skos:scopeNote ""@en .

i14224skos:UpTime a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "time interval during which an item is in an upstate"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "up time"@en ;
    skos:scopeNote ""@en .

i14224skos:Upstream a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "business category of the petroleum industry involving exploration and production"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "upstream"@en ;
    skos:scopeNote ""@en .

i14224skos:Uncertainty a skos:Concept ;
    skos:altLabel ""@en ;
    skos:definition "<of a quantity> inability to determine accurately what is or will be the true value of a quantity"@en ;
    skos:example ""@en ;
    skos:inScheme i14224skos:StandardISO14224;
    skos:prefLabel "uncertainty"@en ;
    skos:scopeNote ""@en .



