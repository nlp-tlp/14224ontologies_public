@prefix i14224: <https://iso14224.org/ontology/i14224/rdl/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cmnsav: <https://www.omg.org/spec/Commons/AnnotationVocabulary#> .

<https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes> rdf:type owl:Ontology ;
    owl:versionIRI <https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes/1.0> ;
    owl:imports <https://iso14224.org/ontology/i14224/ont/appendixA> ,
                <https://iso14224.org/ontology/i14224/ont/appendixB> ;
    dcterms:creator <https://orcid.org/0000-0002-7336-3932> ;
    dcterms:license <https://github.com/nlp-tlp/14224ontologies_public/blob/main/LICENSE> ;
    rdfs:comment "Allowed ISO 14224 Appendix B failure-mode codes by equipment class for Tables B.6 to B.10."@en .

#################################################################
#    Object properties
#################################################################

i14224:hasAllowedFailureMode rdf:type owl:ObjectProperty ;
    rdfs:label "has allowed failure mode"@en ;
    rdfs:domain i14224:EquipmentClass ;
    rdfs:range i14224:FailureMode ;
    skos:definition "relates an ISO 14224 equipment class or equipment type to a failure mode code permitted for that equipment class in ISO 14224 Appendix B"@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes> ;
    cmnsav:directSource "ISO 14224:2006 Appendix B Tables B.6-B.10"@en .

i14224:hasEquipmentClass rdf:type owl:ObjectProperty ;
    rdfs:label "has equipment class"@en ;
    rdfs:range i14224:EquipmentClass ;
    skos:definition "relates a failure event, maintenance record, or asset record to the ISO 14224 equipment class used for failure-mode-code validation"@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes> .

i14224:hasFailedEquipment rdf:type owl:ObjectProperty ;
    rdfs:label "has failed equipment"@en ;
    skos:definition "relates a failure event or maintenance record to the equipment item that failed"@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes> .


#################################################################
#    Helper classes for Table B.9 detector columns
#################################################################

i14224:FireDetector rdf:type owl:Class ;
    rdfs:subClassOf i14224:FireAndGasDetector ;
    rdfs:label "Fire detector"@en ;
    skos:definition "fire-detector equipment class grouping used for ISO 14224 Table B.9 failure-mode-code validation"@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes> ;
    cmnsav:directSource "ISO 14224:2006 Appendix B Table B.9"@en .

i14224:GasDetector rdf:type owl:Class ;
    rdfs:subClassOf i14224:FireAndGasDetector ;
    rdfs:label "Gas detector"@en ;
    skos:definition "gas-detector equipment class grouping used for ISO 14224 Table B.9 failure-mode-code validation"@en ;
    rdfs:isDefinedBy <https://iso14224.org/ontology/i14224/ont/appendixB/allowed-failure-modes> ;
    cmnsav:directSource "ISO 14224:2006 Appendix B Table B.9"@en .

i14224:SmokeCombustionFireDetector rdfs:subClassOf i14224:FireDetector .
i14224:HeatFireDetector rdfs:subClassOf i14224:FireDetector .
i14224:FlameFireDetector rdfs:subClassOf i14224:FireDetector .
i14224:ManualPushbuttonFireDetector rdfs:subClassOf i14224:FireDetector .
i14224:OtherFireDetector rdfs:subClassOf i14224:FireDetector .
i14224:HydrocarbonGasDetector rdfs:subClassOf i14224:GasDetector .
i14224:ToxicGasDetector rdfs:subClassOf i14224:GasDetector .
i14224:OtherGasDetector rdfs:subClassOf i14224:GasDetector .

