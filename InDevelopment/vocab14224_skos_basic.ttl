    skos:prefLabel "Taxonomy"@en ;
    skos:scopeNote ""@en ;
    skos:topConceptOf <https://iso14224.org/skos/scheme/vocab14224_basic> .

iso14224:Turnaround a skos:Concept ;
    dcterms:source <https://iso14224.org/vocab/Turnaround> ;
    skos:altLabel "Revision shutdown"@en,
