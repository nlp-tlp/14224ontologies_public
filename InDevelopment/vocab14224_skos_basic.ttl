    skos:example ""@en ;
    skos:inScheme <https://iso14224.org/skos/scheme/vocab14224_basic> ;
    skos:prefLabel "Turnaround"@en ;
    skos:scopeNote ""@en ;
    skos:topConceptOf <https://iso14224.org/skos/scheme/vocab14224_basic> .

iso14224:Uncertainty a skos:Concept ;
