###  http://iso14224.org/ontology/i14224/ont/appendixB/Inspection
i14224:Inspection rdf:type owl:Class ;
                 rdfs:subClassOf <http://iso14224.org/ontology/i14224/ont/appendixB/MaintenanceActivity> ;
                 rdfs:label "Inspection"@en ;
                 rdfs:seeAlso ""@en ;
                 skos:altLabel ""@en ;
                 skos:definition ""@en ;
                 skos:example ""@en ;
                 skos:scopeNote ""@en ;
                 i14224:iso14224:section ""^^xsd:anyURI ;
                 cmns-av:adaptedFrom ""@en ;
                 cmns-av:directSource "ISO 14224:2023 Appendix B"@en ;
                 cmns-av:explanatoryNote "periodic inspection/check: a careful scrutiny of an item carried out with or without dismantling, normally by use of senses"@en ;
                 cmns-av:usageNote "Typically used in preventative maintenance. All types of general check. Includes minor servicing as part of the inspection task"@en .

