@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix voc: <https://iso14224.org/vocab/> .
@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary#> .

<https://iso14224.org/vocab/extended/> rdf:type owl:Ontology ;
                                        owl:imports <https://iso14224.org/vocab/basic/> .

#################################################################
#    Object Properties
#################################################################

###  https://iso14224.org/vocab/extended/hasFailureDetectionMethod
voc:hasFailureDetectionMethod rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://iso14224.org/vocab/vocab/DetectionMethod> ;
                        rdfs:range voc:TypeFailureDetectionMethod.

###  https://iso14224.org/vocab/extended/hasFailureCause
voc:hasFailureCause rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://iso14224.org/vocab/basic/FailureCause> ;
                        rdfs:range voc:TypeFailureCause.

###  https://iso14224.org/vocab/extended/hasFailureMechanism
voc:hasFailureMechanism rdf:type owl:ObjectProperty .

###  https://iso14224.org/vocab/extended/hasFailureMode
voc:hasFailureMode rdf:type owl:ObjectProperty .

###  https://iso14224.org/vocab/extended/hasFailureCauseType
voc:hasFailureCauseType rdf:type owl:ObjectProperty ;
                         rdfs:domain <https://iso14224.org/vocab/basic/FailureCause> ;
                         rdfs:range voc:TypeFailureCause .



###  https://iso14224.org/vocab/extended/hasFailureMechanismType
voc:hasFailureMechanismType rdf:type owl:ObjectProperty ;
                         rdfs:domain <https://iso14224.org/vocab/basic/FailureMechanism> ;
                         rdfs:rangevoc:TypeFailureMechanism .




