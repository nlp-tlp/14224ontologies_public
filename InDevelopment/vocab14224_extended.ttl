@base <http://www.semanticweb.org/00040628/ontologies/untitled-ontology-24/> .

<https://pid.vocab14224.org/Extended/> rdf:type owl:Ontology ;
                                        owl:imports <https://pid.vocab14224.org/2024-11-06/Basic/1.1> .

#################################################################
#    Object Properties
#################################################################

###  https://pid.vocab14224.org/Extended/hasFailureDetectionMethod
:hasFailureDetectionMethod rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://pid.vocab14224.org/Basic/DetectionMethod> ;
                        rdfs:range :TypeFailureDetectionMethod.

###  https://pid.vocab14224.org/Extended/hasFailureCause
:hasFailureCause rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://pid.vocab14224.org/Basic/FailureCause> ;
                        rdfs:range :TypeFailureCause.

###  https://pid.vocab14224.org/Extended/hasFailureMechanism
:hasFailureMechanism rdf:type owl:ObjectProperty .

###  https://pid.vocab14224.org/Extended/hasFailureMode
:hasFailureMode rdf:type owl:ObjectProperty .

###  https://pid.vocab14224.org/Extended/hasFailureCauseType
:hasFailureCauseType rdf:type owl:ObjectProperty ;
                         rdfs:domain <https://pid.vocab14224.org/Basic/FailureCause> ;
                         rdfs:range :TypeFailureCause .



###  https://pid.vocab14224.org/Extended/hasFailureMechanismType
:hasFailureMechanismType rdf:type owl:ObjectProperty ;
                         rdfs:domain <https://pid.vocab14224.org/Basic/FailureMechanism> ;
                         rdfs:range :TypeFailureMechanism .




