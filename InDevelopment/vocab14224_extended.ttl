###  https://iso14224.org/vocab/extended/Adjust
voc:Adjust rdf:type owl:Class ; 
                 rdfs:subClassOf <https://iso14224.org/vocab/extended/MaintenanceActivity> ;
                 rdfs:label "Adjust"@en ;
                 rdfs:seeAlso ""@en ;
                 skos:altLabel ""@en ;
                 skos:definition ""@en ;
                 skos:example "align, set and reset, calibrate, balance"@en ;
                 skos:scopeNote ""@en ;
                 voc:iso14224:section ""^^xsd:anyURI ;
                 cmns-av:adaptedFrom ""@en ;
                 cmns-av:directSource "ISO 14224:2023 Appendix B"@en ;
                 cmns-av:explanatoryNote "bringing any out-of-tolerance condition into tolerance"@en ;
                 cmns-av:usageNote "typically used in corrective and preventative maintenance"@en .


