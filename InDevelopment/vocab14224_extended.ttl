<http://iso14224.org/ontology/i14224/ont/appendixB/> rdf:type owl:Ontology ;
                                        owl:imports <http://iso14224.org/ontology/i14224/ont/core> .

#################################################################
#    Object Properties
#################################################################

###  http://iso14224.org/ontology/i14224/ont/appendixB/hasFailureDetectionMethod
i14224:hasFailureDetectionMethod rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://iso14224.org/vocab/vocab/DetectionMethod> ;
                        rdfs:range i14224:TypeFailureDetectionMethod.

###  http://iso14224.org/ontology/i14224/ont/appendixB/hasFailureCause
i14224:hasFailureCause rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://iso14224.org/vocab/basic/FailureCause> ;
                        rdfs:range i14224:TypeFailureCause.

###  http://iso14224.org/ontology/i14224/ont/appendixB/hasFailureMechanism
i14224:hasFailureMechanism rdf:type owl:ObjectProperty .

###  http://iso14224.org/ontology/i14224/ont/appendixB/hasFailureMode
i14224:hasFailureMode rdf:type owl:ObjectProperty .

###  http://iso14224.org/ontology/i14224/ont/appendixB/hasFailureCauseType
i14224:hasFailureCauseType rdf:type owl:ObjectProperty ;
                         rdfs:domain <https://iso14224.org/vocab/basic/FailureCause> ;
                         rdfs:range i14224:TypeFailureCause .



###  http://iso14224.org/ontology/i14224/ont/appendixB/hasFailureMechanismType
i14224:hasFailureMechanismType rdf:type owl:ObjectProperty ;
                         rdfs:domain <https://iso14224.org/vocab/basic/FailureMechanism> ;
                         rdfs:rangei14224:TypeFailureMechanism .




