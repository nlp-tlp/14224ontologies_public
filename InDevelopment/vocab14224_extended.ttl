###  https://iso14224.org/vocab/extended/Check
voc:Check rdf:type owl:Class ;
                 rdfs:subClassOf <https://iso14224.org/vocab/extended/MaintenanceActivity> ;
                 rdfs:label "Check" ;
                 rdfs:seeAlso ""@en ;
                 skos:altLabel ""@en ;
                 skos:definition ""@en ;
                 skos:scopeNote ""@en ;
                 voc:iso14224:section ""^^xsd:anyURI ;
                 cmns-av:adaptedFrom ""@en ;
                 cmns-av:directSource "ISO 14224:2023 Appendix B"@en ;
                 cmns-av:explanatoryNote "The cause of failure investigated, but no maintenance action is performed, or action is deferred. Able to regain function by simple actions, e.g. restart or resetting"@en ;
                 skos:example "restart, resetting, no maintenance action, etc. Particularly relevant for functional failures, e.g. fire and gas detectors, subsea equipment. check includes both when a failure cause was revealed but maintenance action was considered either not necessary or not possible to carry out and where no failure cause circumstances could be found"@en ;
                 cmns-av:usageNote "typically used in corrective maintenance"@en .

