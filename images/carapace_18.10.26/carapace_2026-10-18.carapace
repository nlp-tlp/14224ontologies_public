    {
      "id": "3ebe8926-8ef1-4ace-8279-22f917168ca0",
      "name": "MaintenanceActivityType",
      "ttlContent": "@prefix i14224: <https://iso14224.org/ontology/i14224/rdl/> .\n@prefix i14224skos: <https://iso14224.org/skos/> .\n@prefix lis: <http://rds.posccaesar.org/ontology/lis14/rdl/> .\n@prefix dc: <http://purl.org/dc/elements/1.1/> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xml: <http://www.w3.org/XML/1998/namespace> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix schema: <http://schema.org/> .\n@prefix cmnsav: <https://www.omg.org/spec/Commons/AnnotationVocabulary#> .\n@prefix obo: <http://purl.obolibrary.org/obo/> .\n@prefix ex: <http://spec.example.org/> .\n\ni14224:MaintenanceActivity\n    a skos:Concept, owl:Class .\n\ni14224:MaintenanceActivityType\n    a skos:Concept, owl:Class .\n\ni14224:CorrectiveMaintenance\n    a skos:Concept, owl:Class ;\n    rdfs:subClassOf i14224:MaintenanceActivityType ;\n    skos:broader i14224:MaintenanceActivityType ;\n    skos:altLabel \"reactive maintenance\"@en ;\n    skos:definition \"maintenance carried out after fault detection to effect restoration\"@en ;\n    skos:inScheme i14224:StandardISO14224 ;\n    skos:prefLabel \"corrective maintenance\"@en .\n\ni14224:PreventativeMaintenance a skos:Concept, owl:Class ;\n    rdfs:subClassOf i14224:MaintenanceActivityType ;\n    skos:broader i14224:MaintenanceActivityType ;\n    skos:altLabel \"PM\"@en ;\n    skos:definition \"maintenance carried out to mitigate degradation and reduce the probability of failure\"@en ;\n    skos:example \"\"@en ;\n    skos:inScheme i14224:StandardISO14224;\n    skos:prefLabel \"preventative maintenance\"@en ;\n    skos:scopeNote \"\"@en .\n\ni14224:Check rdf:type owl:Class ;\n    rdfs:subClassOf i14224:MaintenanceActivity ;\n    rdfs:label \"Check\" ;\n    skos:altLabel \"restart\",\"reset\"@en ;\n    cmnsav:directSource \"ISO 14224:2023 Appendix B\"@en ;\n    cmnsav:explanatoryNote \"The cause of failure investigated, but no maintenance action is performed, or action is deferred. Able to regain function by simple actions, e.g. restart or resetting etc. Particularly relevant for functional failures, e.g. fire and gas detectors, subsea equipment. check includes both when a failure cause was revealed but maintenance action was considered either not necessary or not possible to carry out and where no failure cause circumstances could be found\"@en ;\n    cmnsav:usageNote \"typically used in corrective maintenance\"@en .\n\ni14224:Replace rdf:type owl:Class ;\n    rdfs:subClassOf i14224:MaintenanceActivity ;\n    rdfs:label \"Replace\"@en ;\n    cmnsav:directSource \"ISO 14224:2023 Appendix B\"@en ;\n    cmnsav:explanatoryNote \"Replacement of the item by a new or refurbished item of the same type and make\"@en ;\n    cmnsav:usageNote \"Typically used in preventative and corrective maintenance. E.g. replacement of a worn-out bearing\"@en .\n\ni14224:MaintenanceStrategyTerms a skos:Collection ;\n    skos:definition \"strategy for maintenance of a specific item\"@en ;\n    skos:example \"corrective maintenance, condition-based maintenance, opportunistic maintenance, planned maintenance, predictive maintenance, reactive maintenance\"@en ;\n    skos:inScheme i14224:StandardISO14224;\n    skos:prefLabel \"maintenance strategy terms\"@en ;\n    skos:scopeNote \"\"@en ;\n        skos:member\n        i14224:ConditionBasedMaintenance,\n        i14224:CorrectiveMaintenance,\n        i14224:OpportunityMaintenance,\n        i14224:PlannedMaintenance,\n        i14224:PreventativeMaintenance,\n        i14224:PredictiveMaintenance .\n\n# Instance data\nex:ma101 rdf:type owl:NamedIndividual, i14224:Replace;\n    i14224:hasMaintenanceActivityType i14224:PreventativeMaintenance .\n\nex:ma102 rdf:type owl:NamedIndividual, i14224:Check;\n    i14224:hasMaintenanceActivityType i14224:CorrectiveMaintenance .",
